# Copy to .env and adjust. All values are optional; defaults live in docker-compose.yml.
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Four slashes = absolute path inside the container (named volume db-data)
DATABASE_URL=sqlite:////data/app.db

# Path to the trained model inside the backend container
MODEL_PATH=/ml/models/model.pkl

# Origins allowed by CORS, comma-separated (only needed for `npm run dev` outside Docker)
CORS_ORIGINS=http://localhost:5173
